# Copie para .env.local (desenvolvimento) e cadastre na Vercel (Settings → Environment Variables).

# Públicas (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA: só no servidor. Supabase → Project Settings → API Keys → Secret keys.
# Usada apenas para cadastrar e bloquear usuários. Nunca commitar, nunca expor no navegador.
SUPABASE_SECRET_KEY=

# Endereço público do app (usado nos links dos e-mails e na mensagem de convite)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
